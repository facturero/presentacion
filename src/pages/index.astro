---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import CrmMock from "../components/CrmMock.astro";
import PosMock from "../components/PosMock.astro";
import { site, hero, strip, crmFeatures, posPoints, steps, faqs } from "../data/content";

const mailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent("Quiero ver una demostración del CRM y el POS Kiosko")}`;
const eyebrow = "mb-3 inline-block text-xs font-bold uppercase tracking-widest text-brand";
const h2 = "text-3xl font-extrabold tracking-tight sm:text-4xl";
const lead = "mt-4 text-lg text-slate-600 dark:text-slate-300";
const btn = "inline-flex items-center justify-center rounded-xl px-5 py-3 font-bold transition hover:-translate-y-0.5";
---

<Layout>
  <Nav />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -right-40 -top-40 size-[640px] rounded-full bg-brand/15 blur-3xl"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 lg:grid-cols-[1.05fr_1fr] lg:py-24">
        <div>
          <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">{hero.title}</h1>
          <p class:list={[lead, "max-w-xl text-xl"]}>{hero.lead}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#contacto" class:list={[btn, "bg-brand text-white shadow-lg shadow-brand/30"]}>Solicitar una demostración</a>
            <a href="#crm" class:list={[btn, "border border-slate-300 hover:bg-white dark:border-slate-700 dark:hover:bg-slate-900"]}>Ver qué incluye</a>
          </div>
          <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
            {hero.badges.map((b) => <li class="flex items-center gap-1.5"><span class="font-black text-teal">✓</span>{b}</li>)}
          </ul>
        </div>
        <div>
          <div class="relative h-[430px] sm:h-[460px]">
            <div class="absolute inset-0 bottom-24 right-6 sm:right-14"><CrmMock /></div>
            <div class="absolute bottom-0 right-0 w-[88%] sm:w-[68%]"><PosMock /></div>
          </div>
          <p class="mt-2 text-right text-xs text-slate-500">Maquetas con datos de ejemplo</p>
        </div>
      </div>
    </section>

    <!-- Ventajas -->
    <section class="border-y border-slate-200 bg-white py-8 dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:grid-cols-2 lg:grid-cols-4">
        {strip.map((s) => (
          <div><b class="block">{s.title}</b><span class="text-sm text-slate-600 dark:text-slate-400">{s.text}</span></div>
        ))}
      </div>
    </section>

    <!-- CRM -->
    <section id="crm" class="mx-auto max-w-6xl px-4 py-20">
      <div class="mb-12 max-w-2xl">
        <span class={eyebrow}>El CRM</span>
        <h2 class={h2}>Todo tu negocio ordenado, y listo para facturar</h2>
        <p class={lead}>Desde la ficha del cliente hasta la factura electrónica, sin saltar entre programas.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {crmFeatures.map((f) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/10 dark:border-slate-800 dark:bg-slate-900">
            <div class="mb-4 grid size-11 place-items-center rounded-xl bg-brand/10 text-brand">
              <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={f.icon} /></svg>
            </div>
            <h3 class="mb-2 font-bold">{f.title}</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">{f.text}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- POS Kiosko -->
    <section id="pos" class="bg-slate-100 py-20 dark:bg-slate-900/50">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 lg:grid-cols-2">
        <div>
          <span class={eyebrow}>{site.product}</span>
          <h2 class={h2}>Una caja que no se detiene</h2>
          <p class:list={[lead, "mb-8"]}>Pensada para el mostrador: arranca directo en la pantalla de ventas, vende aunque falle el internet y se mantiene al día con tu CRM.</p>
          <ul class="grid gap-5">
            {posPoints.map((p) => (
              <li class="grid grid-cols-[28px_1fr] gap-3">
                <span class="grid size-7 place-items-center rounded-full bg-teal/15 text-sm font-black text-teal">✓</span>
                <div><b class="block">{p.title}</b><span class="text-sm text-slate-600 dark:text-slate-400">{p.text}</span></div>
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:order-first">
          <PosMock big />
          <p class="mt-2 text-xs text-slate-500">Maqueta con datos de ejemplo</p>
        </div>
      </div>
    </section>

    <!-- Cómo funciona -->
    <section id="como-funciona" class="mx-auto max-w-6xl px-4 py-20">
      <div class="mb-14 max-w-2xl">
        <span class={eyebrow}>Cómo funciona</span>
        <h2 class={h2}>De cero a vender en tres pasos</h2>
      </div>
      <ol class="grid gap-8 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="relative rounded-2xl border border-slate-200 bg-white p-6 pt-8 dark:border-slate-800 dark:bg-slate-900">
            <span class="absolute -top-4 left-6 grid size-9 place-items-center rounded-full bg-brand font-extrabold text-white">{i + 1}</span>
            <h3 class="mb-2 font-bold">{s.title}</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400">{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Preguntas -->
    <section id="preguntas" class="bg-slate-100 py-20 dark:bg-slate-900/50">
      <div class="mx-auto max-w-3xl px-4">
        <span class={eyebrow}>Preguntas frecuentes</span>
        <h2 class:list={[h2, "mb-8"]}>Lo que suelen preguntar</h2>
        <div class="grid gap-3">
          {faqs.map((f) => (
            <details class="group rounded-2xl border border-slate-200 bg-white px-5 dark:border-slate-800 dark:bg-slate-900">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-2xl leading-none text-brand transition group-open:rotate-45">+</span>
              </summary>
              <p class="pb-4 text-slate-600 dark:text-slate-400">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="mx-auto max-w-6xl px-4 py-20">
      <div class="grid items-center gap-10 rounded-3xl bg-gradient-to-br from-brand to-violet-600 p-8 text-white sm:p-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Veamos cómo encaja en tu negocio</h2>
          <p class="mt-4 opacity-90">Cuéntanos qué vendes y cuántas cajas necesitas. Te mostramos el CRM y la caja funcionando y te decimos qué hace falta para empezar.</p>
        </div>
        <form id="contact-form" class="grid gap-3" data-mailto={mailto}>
          <label class="grid gap-1.5 text-sm font-semibold">Tu nombre
            <input name="nombre" required autocomplete="name" class="rounded-xl bg-white/95 px-4 py-3 font-normal text-slate-900 outline-none focus-visible:ring-4 focus-visible:ring-white/40" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold">¿Qué negocio tienes?
            <textarea name="negocio" rows="3" class="rounded-xl bg-white/95 px-4 py-3 font-normal text-slate-900 outline-none focus-visible:ring-4 focus-visible:ring-white/40"></textarea>
          </label>
          <button class:list={[btn, "bg-slate-900 text-white"]} type="submit">Escribirnos</button>
          <small class="opacity-80">Se abrirá tu programa de correo con el mensaje listo para enviar.</small>
        </form>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 py-10 text-sm text-slate-500 dark:border-slate-800">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4">
      <span>© {new Date().getFullYear()} {site.name} · {site.product} es un producto de {site.name}</span>
      <a href={site.crmUrl} class="font-semibold hover:text-brand">Entrar al CRM</a>
    </div>
  </footer>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const body = `Hola, soy ${data.get("nombre")}.\n\nMi negocio: ${data.get("negocio") || "(sin detalle)"}`;
      window.location.href = `${form.dataset.mailto}&body=${encodeURIComponent(body)}`;
    });
  </script>
</Layout>
