---
import { profiles, roadmap } from "../data/content";
---

<div id="profile-tabs">
  <div role="tablist" aria-label="Tipo de negocio" class="mb-6 flex flex-wrap gap-2">
    {profiles.map((p, i) => (
      <button
        role="tab"
        type="button"
        id={`tab-${p.id}`}
        aria-controls={`panel-${p.id}`}
        aria-selected={i === 0 ? "true" : "false"}
        class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold transition hover:border-brand aria-selected:border-brand aria-selected:bg-brand aria-selected:text-white dark:border-slate-700"
      >
        {p.label}
      </button>
    ))}
  </div>

  {profiles.map((p, i) => (
    <div role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0} class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900">
      <p class="mb-5 text-lg text-slate-600 dark:text-slate-300">{p.blurb}</p>
      <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {p.modules.map((mod) => (
          <li class:list={["flex items-center justify-between gap-3 rounded-xl border px-4 py-3 text-sm", mod.ready ? "border-slate-200 dark:border-slate-800" : "border-dashed border-slate-300 text-slate-500 dark:border-slate-700"]}>
            <span class:list={[mod.essential && "font-bold"]}>{mod.name}</span>
            <span class:list={["shrink-0 rounded-full px-2 py-0.5 text-[11px] font-bold", mod.ready ? "bg-teal/15 text-teal" : "bg-slate-200 text-slate-600 dark:bg-slate-800 dark:text-slate-400"]}>{mod.ready ? "Disponible" : "Pronto"}</span>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-xs text-slate-500">En negrita, lo esencial para este tipo de negocio. Activas los módulos que quieras desde el sistema.</p>
    </div>
  ))}

  <div class="mt-10">
    <h3 class="mb-3 font-bold">Y seguimos creciendo</h3>
    <p class="mb-3 text-sm text-slate-600 dark:text-slate-400">Estas áreas están en camino, para que el sistema cubra cada vez más de tu negocio:</p>
    <ul class="flex flex-wrap gap-2">
      {roadmap.map((r) => <li class="rounded-full border border-dashed border-slate-300 px-3 py-1 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-400">{r}</li>)}
    </ul>
  </div>
</div>

<script>
  const root = document.getElementById("profile-tabs");
  const tabs = Array.from(root?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(t));
    // Flechas izquierda/derecha entre pestañas, como pide el patrón de pestañas accesibles.
    t.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>
