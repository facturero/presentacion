---
import { content, site } from "../data/content";
import { getDict, localeNames, locales, localePath, switchLocalePath, type Locale } from "../i18n";

const { lang } = Astro.props as { lang: Locale };
const d = getDict(lang);
const { nav } = content(lang);
const here = Astro.url.pathname;
const link = "rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-200/60 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white";
---

<header class="sticky top-0 z-20 border-b border-slate-200 bg-slate-50/85 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href={localePath(lang, "/")} class="flex items-center gap-2 font-extrabold tracking-tight">
      <span class="grid size-8 place-items-center rounded-lg bg-brand text-xs font-extrabold text-white">NS</span>
      {site.name}
    </a>
    <nav id="menu" class="absolute inset-x-0 top-16 hidden flex-col gap-1 data-[open]:flex border-b border-slate-200 bg-slate-50 p-4 md:static md:flex md:flex-row md:items-center md:border-0 md:bg-transparent md:p-0 dark:border-slate-800 dark:bg-slate-950 dark:md:bg-transparent">
      {nav.map((i) => (
        <a href={i.href} class={link}>{i.label}</a>
      ))}
      <a href={site.crmUrl} class={link}>{d.ui.login}</a>
      <!-- Selector de idioma: enlaces normales (no JS), a la MISMA página en otro idioma. -->
      <div role="group" aria-label={d.ui.language} class="flex items-center gap-1 px-1 md:ml-1">
        {locales.map((l) => (
          <a
            href={switchLocalePath(here, l)}
            lang={l}
            hreflang={l}
            title={localeNames[l]}
            aria-current={l === lang ? "true" : undefined}
            class:list={["rounded-md px-2 py-1 text-xs font-bold uppercase tracking-wide", l === lang ? "bg-brand/10 text-brand" : "text-slate-500 hover:bg-slate-200/60 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-white"]}
          >{l}</a>
        ))}
      </div>
      <a href={site.trialUrl} class="mt-2 rounded-xl bg-brand px-4 py-2 text-center text-sm font-bold text-white hover:opacity-90 md:ml-1 md:mt-0">{d.ui.tryFree}</a>
    </nav>
    <button id="menu-btn" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold md:hidden dark:border-slate-700" aria-expanded="false" aria-controls="menu">{d.ui.menu}</button>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("menu");
  const setOpen = (open: boolean) => {
    if (open) menu?.setAttribute("data-open", "");
    else menu?.removeAttribute("data-open");
    btn?.setAttribute("aria-expanded", String(open));
  };
  btn?.addEventListener("click", () => setOpen(!menu?.hasAttribute("data-open")));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
