---
import { content, site } from "../data/content";
import { getDict, localeNames, locales, localePath, switchLocalePath, type Locale } from "../i18n";

const { lang } = Astro.props as { lang: Locale };
const d = getDict(lang);
const { nav } = content(lang);
const here = Astro.url.pathname;
const link = "rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-200/60 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white";
---

<header class="sticky top-0 z-20 border-b border-slate-200 bg-slate-50/85 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href={localePath(lang, "/")} class="flex items-center gap-2 font-extrabold tracking-tight">
      <span class="grid size-8 place-items-center rounded-lg bg-brand text-xs font-extrabold text-white">NS</span>
      {site.name}
    </a>
    <nav id="menu" class="absolute inset-x-0 top-16 hidden flex-col gap-1 data-[open]:flex border-b border-slate-200 bg-slate-50 p-4 md:static md:flex md:flex-row md:items-center md:border-0 md:bg-transparent md:p-0 dark:border-slate-800 dark:bg-slate-950 dark:md:bg-transparent">
      {nav.map((i) => (
        <a href={i.href} class={link}>{i.label}</a>
      ))}
      <a href={site.crmUrl} class={link}>{d.ui.login}</a>
      <!-- Selector de idioma: un menú con el idioma actual (globo + nombre) y los tres con su nombre completo. Son enlaces normales
           (sin JS para navegar) a la MISMA página en otro idioma; el script de abajo solo lo cierra al pulsar fuera o con Esc. -->
      <details id="lang-menu" class="group relative md:ml-1">
        <summary
          aria-label={`${d.ui.language}: ${localeNames[lang]}`}
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:border-brand hover:text-brand md:py-1.5 dark:border-slate-700 dark:text-slate-200 [&::-webkit-details-marker]:hidden"
        >
          <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path></svg>
          <span>{localeNames[lang]}</span>
          <svg viewBox="0 0 24 24" class="size-3.5 fill-none stroke-current transition group-open:rotate-180" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </summary>
        <ul class="mt-1 grid min-w-40 gap-0.5 rounded-xl border border-slate-200 bg-white p-1 shadow-xl shadow-slate-900/10 md:absolute md:right-0 md:top-full md:z-30 md:mt-2 dark:border-slate-700 dark:bg-slate-900">
          {locales.map((l) => (
            <li>
              <a
                href={switchLocalePath(here, l)}
                lang={l}
                hreflang={l}
                aria-current={l === lang ? "true" : undefined}
                class:list={["flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-semibold", l === lang ? "bg-brand/10 text-brand" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"]}
              >
                {localeNames[l]}
                {l === lang && <span aria-hidden="true">✓</span>}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <a href={site.trialUrl} class="mt-2 rounded-xl bg-brand px-4 py-2 text-center text-sm font-bold text-white hover:opacity-90 md:ml-1 md:mt-0">{d.ui.tryFree}</a>
    </nav>
    <button id="menu-btn" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold md:hidden dark:border-slate-700" aria-expanded="false" aria-controls="menu">{d.ui.menu}</button>
  </div>
</header>

<script>
  // Con la navegación sin recarga, este módulo se ejecuta UNA vez pero la cabecera se reemplaza en cada página: lo que depende de
  // sus elementos se vuelve a enlazar en `astro:page-load`; lo que cuelga del documento se registra una sola vez.
  function bindMenu() {
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("menu");
    const setOpen = (open: boolean) => {
      if (open) menu?.setAttribute("data-open", "");
      else menu?.removeAttribute("data-open");
      btn?.setAttribute("aria-expanded", String(open));
    };
    btn?.addEventListener("click", () => setOpen(!menu?.hasAttribute("data-open")));
    menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  }
  document.addEventListener("astro:page-load", bindMenu);

  // El selector de idioma es un <details>: se cierra al pulsar fuera de él o con Esc.
  const langMenu = () => document.getElementById("lang-menu") as HTMLDetailsElement | null;
  document.addEventListener("click", (e) => {
    const lang = langMenu();
    if (lang?.open && !lang.contains(e.target as Node)) lang.open = false;
  });
  document.addEventListener("keydown", (e) => {
    const lang = langMenu();
    if (e.key === "Escape" && lang?.open) {
      lang.open = false;
      lang.querySelector("summary")?.focus();
    }
  });
</script>
